{
  "name": "griefer-hub",
  "version": "0.1.0",
  "description": "A community-driven platform for tracking and reporting griefers",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ralph": "ts-node .agent/scripts/ralph.ts",
    "ralph:init": "ts-node .agent/scripts/ralph.ts --init",
    "ralph:validate": "ts-node .agent/scripts/ralph.ts --validate",
    "ralph:help": "ts-node .agent/scripts/ralph.ts --help"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "airtable": "^0.12.2",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "next": "^14.0.0",
    "next-auth": "^4.24.13",
    "postcss": "^8.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.70.0",
    "swr": "^2.3.8",
    "tailwindcss": "^3.4.19",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.29",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "griefer",
    "tracking",
    "gaming",
    "community",
    "reporting"
  ],
  "author": "GrieferHub Team",
  "license": "MIT"
}
